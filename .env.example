NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Play review login: configure only when a dedicated review account is ready.
# Production enablement bypasses SMS for ONE exact phone number only. Use a
# dedicated account with non-sensitive data; read-only access is not enforced here.
# Never commit real phone numbers / OTPs.
GOOGLE_PLAY_TEST_MODE=false
GOOGLE_PLAY_TEST_PHONE=
GOOGLE_PLAY_TEST_OTP=
ROYALHOUSE_ADMIN_PASSWORD=

# Web Push (server-side only)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional MyID integration (server-side only)
MYID_CLIENT_ID=
MYID_REDIRECT_URI=
MYID_AUTH_URL=

# Optional: enable Supabase Storage Image Transformations for listing cards
# Set to true only after Image Transformations are enabled and verified in Supabase.
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=false

# Payme Merchant API / hosted checkout
# Keep the merchant key server-side only; never expose it via NEXT_PUBLIC_*.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
NEXT_PUBLIC_SITE_URL=https://royalhouse.uz

# Cloudflare Stream (server-side only)
# Used for direct, resumable listing-video uploads and automatic encoding/delivery.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Telegram bot notifications (server-side only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
