NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ROYALHOUSE_ADMIN_PASSWORD=

# Web Push (server-side only)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional MyID integration (server-side only)
MYID_CLIENT_ID=
MYID_REDIRECT_URI=
MYID_AUTH_URL=

# Optional: enable Supabase Storage Image Transformations for listing cards
# Set to true only after Image Transformations are enabled and verified in Supabase.
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=false

# Payme Merchant API / hosted checkout
# Keep the merchant key server-side only; never expose it via NEXT_PUBLIC_*.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
NEXT_PUBLIC_SITE_URL=https://royalhouse.uz

# Production deployment trigger
